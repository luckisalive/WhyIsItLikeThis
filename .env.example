# Neo4j AuraDB
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=YOUR_NEO4J_PASSWORD

# GitHub Personal Access Token
GITHUB_TOKEN=YOUR_GITHUB_TOKEN

# Groq Cloud (Reasoning & query answering with multi-model cascade)
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b

# Google Gemini (Extraction with multi-model rate-limit cascade + embeddings)
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-2.5-flash,gemini-3-flash,gemini-3.6-flash,gemini-3.7-flash,gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# Cross-provider failover (fallback to Groq if all Gemini quotas are exhausted, and vice versa)
ENABLE_CROSS_PROVIDER_FALLBACK=true

# Rate limit cooldown seconds if all models across both providers are exhausted
RATE_LIMIT_COOLDOWN_SECONDS=60


# Target Repository
TARGET_REPO=tiangolo/fastapi

